{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
	"type": "file",
	"source": "~/.config/fastfetch/neko.txt",
	"color": {
        "1": "light_blue",
	   },
    "padding": {
        "left": 1
        }
    },

    "display": {
	"percent": {
	    "type": 9,
            "color": {
            "green": "light_magenta",
                "yellow": "dim_magenta",
                "red": "light_red"
            }
        }
    },

    "modules": [
        "break",

        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────────── Catware ────────────────────────┐"
        },
        {
            "type": "host",
            "key": " CompUwUter",
            "keyColor": "light_blue"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "light_blue"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "light_blue"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "light_blue",
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "light_blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└───────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────────── UwUware ────────────────────────┐"
        },
        {
            "type": "os",
            "key": " OwOS",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "magenta"
        },
        {
            "type": "bios",
            "key": "│ ├",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "magenta"
        },
        {
             "type": "custom",
             "format": "\u001b[90m└───────────────────────────────────────────────────────────┘"
        },
        
        "break",
	
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────── Neko Environment ────────────────────┐"
        },
        {
            "type": "de",
            "key": " Neko",
            "keyColor": "light_blue"
        },
        {
            "type": "lm",
            "key": "│ ├",
            "keyColor": "light_blue"
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "light_blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "light_blue"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "light_blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└───────────────────────────────────────────────────────────┘"
        },

        "break",

        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────────── UwUtime /  DT ─────────────────────┐"
        },
        {
            "type": "uptime",
            "key": "  UwUtime ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "  NyaTime ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└───────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
    ]
}
